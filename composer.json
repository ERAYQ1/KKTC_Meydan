{
    "name": "erayq1/kktc-meydan",
    "type": "project",
    "description": "KKTC Meydan - Kıbrıs'ın Özgür Tartışma ve Topluluk Meydanı",
    "license": "MIT",
    "require": {
        "flarum/core": "^1.8.0",
        "flarum-lang/turkish": "*",
        "flarum/tags": "*",
        "flarum/subscriptions": "*",
        "flarum/likes": "*",
        "flarum/lock": "*",
        "flarum/mentions": "*",
        "flarum/markdown": "*",
        "flarum/bbcode": "*",
        "flarum/emoji": "*",
        "flarum/suspend": "*",
        "flarum/sticky": "*",
        "flarum/approval": "*"
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "flarum/composer-plugin": true
        }
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
