{
    "name": "kktcmeydan/platform",
    "type": "project",
    "description": "KKTC Meydan — Kıbrıs'ın Özgür Tartışma, Haber, Ulaşım ve Topluluk Platformu",
    "keywords": ["kktc", "kibris", "meydan", "topluluk", "forum"],
    "license": "MIT",
    "require": {
        "flarum-lang/turkish": "*",
        "flarum/approval": "*",
        "flarum/bbcode": "*",
        "flarum/core": "^1.8.0",
        "flarum/emoji": "*",
        "flarum/flags": "*",
        "flarum/likes": "*",
        "flarum/lock": "*",
        "flarum/markdown": "*",
        "flarum/mentions": "*",
        "flarum/sticky": "*",
        "flarum/subscriptions": "*",
        "flarum/suspend": "*",
        "flarum/tags": "*",
        "kktcmeydan/business-profile": "*@dev",
        "kktcmeydan/classifieds": "*@dev",
        "kktcmeydan/event-calendar": "*@dev",
        "kktcmeydan/report-status": "*@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "extensions/*"
        }
    ],
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "flarum/composer-plugin": true
        }
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
