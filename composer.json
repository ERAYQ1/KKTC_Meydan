{
    "name": "kktcmeydan/platform",
    "type": "project",
    "description": "KKTC Meydan — Kıbrıs'ın Özgür Tartışma, Haber, Ulaşım ve Topluluk Platformu",
    "keywords": ["kktc", "kibris", "meydan", "topluluk", "forum"],
    "license": "MIT",
    "require": {
        "flarum-lang/turkish": "*",
        "flarum/approval": "*",
        "flarum/bbcode": "*",
        "flarum/core": "^1.8.0",
        "flarum/emoji": "*",
        "flarum/flags": "*",
        "flarum/likes": "*",
        "flarum/lock": "*",
        "flarum/markdown": "*",
        "flarum/mentions": "*",
        "flarum/sticky": "*",
        "flarum/subscriptions": "*",
        "flarum/suspend": "*",
        "flarum/tags": "*",
        "fof/best-answer": "^1.7",
        "fof/formatting": "^1.1",
        "fof/gamification": "^1.6",
        "fof/oauth": "^1.7",
        "fof/pages": "^1.0",
        "fof/polls": "^2.3",
        "fof/seo": "^3.0",
        "fof/sitemap": "^2.6",
        "fof/terms": "^1.5",
        "ianm/follow-users": "^1.5",
        "kktcmeydan/ads-manager": "*@dev",
        "kktcmeydan/analytics-dashboard": "*@dev",
        "kktcmeydan/anonymous-posting": "*@dev",
        "kktcmeydan/auto-moderation": "*@dev",
        "kktcmeydan/business-profile": "*@dev",
        "kktcmeydan/classifieds": "*@dev",
        "kktcmeydan/event-calendar": "*@dev",
        "kktcmeydan/mobile-ui": "*@dev",
        "kktcmeydan/report-status": "*@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "extensions/*"
        }
    ],
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "flarum/composer-plugin": true
        }
    },
    "minimum-stability": "beta",
    "prefer-stable": true,
    "require-dev": {
        "flarum/phpstan": "^1.8",
        "flarum/testing": "^1.0",
        "phpstan/phpstan": "^1.8"
    },
    "autoload-dev": {
        "psr-4": {
            "KktcMeydan\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:setup": "@php -r \"require 'vendor/autoload.php'; (new Flarum\\Testing\\integration\\Setup\\SetupScript())->run();\"",
        "verify:anonymity": "@php scripts/verify-anonymity.php",
        "phpstan": "phpstan analyse --no-progress"
    },
    "scripts-descriptions": {
        "test": "PHPUnit regresyon testlerini calistirir (once test:setup gerekir).",
        "test:setup": "AYRI test veritabanini kurar. DB_* ve FLARUM_TEST_TMP_DIR ortam degiskenlerini kullanir. Hedef veritabanindaki TUM tablolari siler - asla canli DB gostermeyin.",
        "verify:anonymity": "Calisan siteye karsi gercek HTTP istekleriyle anonimlik sizintisi tarar.",
        "phpstan": "Statik analiz (level 5) - extensions/*/src."
    }
}
