# Flarum runtime & generated files
/vendor/
/public/assets/*.js
/public/assets/*.js.map
/public/assets/*.css
/public/assets/rev-manifest.json
/public/assets/fonts/
/public/assets/xslt-polyfill/
/storage/cache/*
/storage/formatter/*
/storage/logs/*
/storage/sessions/*
/storage/views/*
/storage/less/*
/storage/locale/*
!/storage/logs/.gitkeep

# Local extension JS build tooling (dist/ is committed so a fresh clone
# works without running npm install/build; node_modules is regenerable)
/extensions/*/js/node_modules/

# Sensitive config files
config.php
.env

# Database data volume
/db_data/

# System / Editor files
.DS_Store
.idea/
.vscode/
*.log
